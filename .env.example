# ---- LLM provider (Task 3) ----
# Provider: "anthropic" | "openai" | "gemini" | "openai_compat" | "mock"
EHR_LLM_PROVIDER=gemini

# Model name — REQUIRED for any real provider; no built-in defaults.
# I used gemini-3.5-flash-lite for example
LLM_MODEL=

# API keys, only the one matching your provider is needed.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

